# Copy this file to `.env` (do not commit).
#
# Policy:
# - Keep secrets in `.env` only.
# - Keep strategy thresholds and other non-secret defaults in `config.yaml`.
# - Do NOT define the same key in both `.env` and `config.yaml` (conflict fails closed).
# - Never expose `SUPABASE_SERVICE_ROLE_KEY` or `GITHUB_PAT` to browser/client code.

# --- KIS (required for CLI scan/sell)
KIS_APP_KEY=
KIS_APP_SECRET=
# Optional: omit when using config.yaml `kis.base_url`.
KIS_BASE_URL=

# --- Supabase (required for v1.1 web + pipelines)
SUPABASE_URL=
# Recommended (new API keys): server-side secret key.
SUPABASE_SECRET_KEY=
# Legacy fallback: service_role key.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: override reports bucket name (default: reports).
SUPABASE_REPORTS_BUCKET=
# Optional: set true to upload from local CLI runs too.
SAB_UPLOAD_REPORTS=false

# --- Web local runtime (required for v1.1 web)
# Web 로그인은 관리자 계정 + 서버 발급 세션 쿠키로 보호합니다.
SAB_BASIC_AUTH_USER=
SAB_BASIC_AUTH_PASS=
# 32자 이상 랜덤 문자열(예: openssl rand -hex 32)
SAB_SESSION_SECRET=
# Optional: 로그인 실패 허용 횟수/윈도우/차단 시간(초)
# SAB_LOGIN_MAX_ATTEMPTS=5
# SAB_LOGIN_WINDOW_SECONDS=900
# SAB_LOGIN_BLOCK_SECONDS=900
#
# 참고: Web API(`/api/holdings*`, `/api/reports*`, `/api/run`)는 로컬 호스트 요청만 허용합니다.
# Host binding port for web container (change if occupied).
WEB_HOST_PORT=55300

# --- Web trigger (required for v1.1 Run screen)
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_PAT=
# UI display hint only (actual cleanup runs in GitHub Actions).
REPORT_RETENTION_DAYS=30
# Optional: report ticker search scan window (default: 100, min: 10, max: 1000).
REPORT_SEARCH_WINDOW=100
# Holdings list pagination (API): `limit`/`cursor` 쿼리와 UI Load more를 사용합니다.

# --- Notify (optional; used for scheduled automation)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SLACK_WEBHOOK_URL=

# --- Optional: CLI logging
LOG_LEVEL=INFO

# --- Optional: config path override (default: config.yaml)
# SAB_CONFIG=config.yaml
