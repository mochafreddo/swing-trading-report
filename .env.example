# Copy this template to a private file outside the repository and synced folders.
# Set owner-only permissions (chmod 600). Never put secret values in this file.
# Values are literal text, without shell expansion. Quotes around values are optional.

# Toss OAuth client credentials; --issue-tokens invalidates its previous token.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=

# KIS production API credentials (public stock data only).
KIS_APP_KEY=
KIS_APP_SECRET=

# Existing tokens can be supplied instead of requesting new ones.
# These are optional with --issue-tokens; neither token is written to disk.
TOSS_ACCESS_TOKEN=
KIS_ACCESS_TOKEN=
