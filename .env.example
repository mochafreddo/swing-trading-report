# Copy this file to `.env` (do not commit).
#
# Policy:
# - Keep secrets in `.env` only.
# - Keep strategy thresholds and other non-secret defaults in `config.yaml`.
# - Do NOT define the same key in both `.env` and `config.yaml` (conflict fails closed).
# - Never expose `SUPABASE_SERVICE_ROLE_KEY` or `GITHUB_PAT` to browser/client code.
# - Main env guide: docs/configuration.md. Full override reference: docs/config-reference.md.

# --- KIS (required for KIS-backed scan/sell/entry and scheduled AI Brief)
KIS_APP_KEY=
KIS_APP_SECRET=
# Optional: omit when using config.yaml `kis.base_url`.
# KIS_BASE_URL=
# Optional: 시장별 캐시 허용 stale 세션 상한 (기본값: 1)
# MARKET_CACHE_STALE_SESSIONS_KR=1
# MARKET_CACHE_STALE_SESSIONS_US=1
# Optional: KIS 호출 간 최소 간격(ms). 보통은 config.yaml `kis.min_interval_ms`를 사용하세요.
# KIS_MIN_INTERVAL_MS=200

# --- Supabase (required for v1.1 web + pipelines)
SUPABASE_URL=
# Recommended (new API keys): server-side secret key.
SUPABASE_SECRET_KEY=
# Legacy fallback: service_role key.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: override reports bucket name (default: reports).
SUPABASE_REPORTS_BUCKET=
# Optional: set true to upload from local CLI runs too.
SAB_UPLOAD_REPORTS=false

# --- Web local runtime (required for v1.1 web)
# Web 로그인은 관리자 계정 + 서버 발급 세션 쿠키로 보호합니다.
SAB_BASIC_AUTH_USER=
SAB_BASIC_AUTH_PASS=
# 32자 이상 랜덤 문자열(예: openssl rand -hex 32)
SAB_SESSION_SECRET=
# Optional: 로그인 실패 허용 횟수/윈도우/차단 시간(초)
# SAB_LOGIN_MAX_ATTEMPTS=5
# SAB_LOGIN_WINDOW_SECONDS=900
# SAB_LOGIN_BLOCK_SECONDS=900
# Optional: Supabase 로그인 스로틀 저장소 장애 시 처리 방식 (`degrade`/`strict`, 기본 `strict`)
# SAB_LOGIN_THROTTLE_FAIL_MODE=strict
# Optional: 런타임 상태 저장소 선택 (`supabase` 권장, 테스트 기본값은 `memory`)
# SAB_RUNTIME_STATE_STORE=supabase
#
# 참고: Web API의 필수 보호 경계는 관리자 세션 인증 + same-origin 검증입니다.
# Host 기반 로컬 요청 하드닝은 기본 활성입니다.
# Optional: 신뢰된 경계(예: 내부 프록시)에서만 비활성화하세요.
# non-loopback `WEB_BIND_HOST`는 `SAB_ALLOW_NON_LOOPBACK_BIND=1` 없이
# `pnpm --dir web run dev/start` 시작 단계에서 실패합니다.
# SAB_ENFORCE_LOCAL_REQUEST=0
# Optional: `pnpm --dir web run dev/start` 직접 실행 시 바인딩 호스트 (기본: 127.0.0.1)
# 직접 실행의 외부 노출은 지원하지 않습니다. Docker Compose는 호스트 publish가
# `127.0.0.1:${WEB_HOST_PORT}:3000`이면 지원 경로입니다.
# WEB_BIND_HOST=127.0.0.1
# SAB_ALLOW_NON_LOOPBACK_BIND=1
# Optional: web 서버 외부 연동(fetch) timeout 밀리초 (기본: 10000)
# SAB_EXTERNAL_FETCH_TIMEOUT_MS=10000
# Host binding port for web container (change if occupied).
WEB_HOST_PORT=55300
# Host binding port for web-dev container (docker compose --profile dev).
WEB_DEV_HOST_PORT=55301

# --- Web trigger (optional; enable only when using /api/run)
RUN_DISPATCH_ENABLED=0
# Required when RUN_DISPATCH_ENABLED=1.
GITHUB_OWNER=
GITHUB_REPO=
GITHUB_PAT=
# UI display hint only (actual cleanup runs in GitHub Actions).
REPORT_RETENTION_DAYS=30
# Optional: report ticker search scan window (default: 100, min: 10, max: 1000).
REPORT_SEARCH_WINDOW=100
# Holdings list pagination (API): `limit`/`cursor` 쿼리와 UI Load more를 사용합니다.

# --- Toss Securities Open API (optional; used by web holdings dry-run sync)
# TOSS_INVEST_CLIENT_ID=
# TOSS_INVEST_CLIENT_SECRET=
# `GET /api/v1/accounts`의 accountSeq 값입니다. 실제 계좌 식별자는 커밋하지 마세요.
# TOSS_INVEST_ACCOUNT=
# Optional: override Toss Open API base URL (default: https://openapi.tossinvest.com)
# TOSS_INVEST_BASE_URL=https://openapi.tossinvest.com

# --- Notify (optional; used for scheduled automation)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# SLACK_WEBHOOK_URL=

# --- Local scheduled AI Brief (non-secret host wrapper setting)
# Put scheduler secrets in `.env.scheduler.local` and keep that file uncommitted.
SAB_SCHEDULER_ENV_FILE=.env.scheduler.local

# --- Optional: CLI logging
LOG_LEVEL=INFO
# Optional: entry_price 누락 비율 임계치 override.
# 기본 운영값은 config.yaml `entry_check.fatal_missing_price_ratio`입니다.
# YAML config가 로드되는 실행에서는 YAML에 두세요. env override는 YAML이 없을 때만 허용됩니다.
# 0.0은 누락이 1건이라도 있으면 `sab entry` exit 1로 처리합니다.
# ENTRY_FATAL_MISSING_PRICE_RATIO=0.0
# Optional: 비시크릿 설정 override. 가능하면 config.yaml에 두고, 환경별로 꼭 갈라야 할 때만 사용하세요.
# DATA_PROVIDER=kis
# SCREEN_LIMIT=30
# WATCHLIST_FILE=watchlist.txt
# UNIVERSE_MARKETS=KR,US
# REPORT_DIR=reports
# DATA_DIR=data
# Optional: market regime benchmark unavailable 처리 정책 override.
# 기본 운영값은 config.yaml `strategy.market_regime_unavailable_policy`입니다.
# YAML config가 로드되는 실행에서는 YAML에 두세요. env override는 YAML이 없을 때만 허용됩니다.
# MARKET_REGIME_UNAVAILABLE_POLICY=block_market
# FX_MODE=kis
# USD_KRW_RATE=1320.0
# FX_CACHE_TTL=10
# FX_KIS_SYMBOL=AAPL.NAS
# PORTFOLIO_MAX_ACTIVE_HOLDINGS=8
# Optional: config.yaml `strategy.min_history_bars` env 오버라이드(코드 기본값 120, 권장 200)
# MIN_HISTORY_BARS=200
# Optional: AI Brief OpenAI model provider (`sab ai-brief --model-provider openai`)
# OPENAI_API_KEY=
# OPENAI_AI_BRIEF_MODEL=
# AI_BRIEF_MODEL_TIMEOUT_SECONDS=20
# Optional: AI Brief external source API provider (`--source-provider http-json`)
# The API receives eligible tickers and returns a JSON object with `sources[]`.
# AI_BRIEF_SOURCE_API_URL=
# AI_BRIEF_SOURCE_API_TOKEN=
# AI_BRIEF_SOURCE_TIMEOUT_SECONDS=10
# Optional: AI Brief Finnhub source provider (`--source-provider finnhub`, US only)
# FINNHUB_API_KEY=
# Optional: AI Brief Polygon News source provider (`--source-provider polygon-news`, US only)
# POLYGON_API_KEY=
# Optional: AI Brief Alpha Vantage News source provider (`--source-provider alpha-vantage-news`, US only)
# ALPHA_VANTAGE_API_KEY=
# Optional: AI Brief Marketaux News source provider (`--source-provider marketaux-news`, US only)
# MARKETAUX_API_TOKEN=
# Optional: AI Brief Benzinga News source provider (`--source-provider benzinga-news`, US only)
# BENZINGA_API_TOKEN=
# Optional: AI Brief Naver News source provider (`--source-provider naver-news`, KR only)
# NAVER_CLIENT_ID=
# NAVER_CLIENT_SECRET=
# Optional scheduled AI Brief defaults (GitHub repository variables or local
# scheduler env; not secrets). Prefer market-specific chain values for scheduled
# KR/US runs. Single-provider values remain supported as fallback/rollback controls.
# AI_BRIEF_SOURCE_PROVIDER_CHAIN_KR=naver-news
# AI_BRIEF_SOURCE_PROVIDER_CHAIN_US=finnhub,benzinga-news,polygon-news
# AI_BRIEF_SOURCE_PROVIDER_CHAIN=finnhub,benzinga-news
# AI_BRIEF_SOURCE_PROVIDER_KR=naver-news
# AI_BRIEF_SOURCE_PROVIDER_US=finnhub
# AI_BRIEF_SOURCE_PROVIDER_US=polygon-news
# AI_BRIEF_SOURCE_PROVIDER_US=alpha-vantage-news
# AI_BRIEF_SOURCE_PROVIDER_US=marketaux-news
# AI_BRIEF_SOURCE_PROVIDER_US=benzinga-news
# AI_BRIEF_SOURCE_API_URL_KR=
# AI_BRIEF_SOURCE_API_URL_US=
# AI_BRIEF_SOURCE_PROVIDER=finnhub
# AI_BRIEF_SOURCE_PROVIDER=polygon-news
# AI_BRIEF_SOURCE_PROVIDER=alpha-vantage-news
# AI_BRIEF_SOURCE_PROVIDER=marketaux-news
# AI_BRIEF_SOURCE_PROVIDER=benzinga-news
# AI_BRIEF_SOURCE_PROVIDER=naver-news
# Live RSS/Atom/RDF feed collection uses `scripts/collect_ai_brief_sources.py`
# with `--feed-timeout-seconds` (default: 10); no API token is used.

# --- Optional: config path override (default: config.yaml)
# SAB_CONFIG=config.yaml
# Optional: strict config parsing (CI/GitHub Actions에서는 강제 true)
# SAB_CONFIG_STRICT=true
