# Copy this file to `.env` (do not commit).
#
# Policy:
# - Keep secrets in `.env` only.
# - Keep non-secret settings in `config.yaml`.
# - Do NOT define the same key in both `.env` and `config.yaml` (conflict fails closed).

# --- KIS secrets (required)
KIS_APP_KEY=
KIS_APP_SECRET=

# --- Optional: logging
LOG_LEVEL=INFO

# --- Optional: config path override (default: config.yaml)
# SAB_CONFIG=config.yaml
