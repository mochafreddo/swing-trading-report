{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "Asia/Seoul",
  "schedule": [
    "before 9am on monday"
  ],
  "updateNotScheduled": true,
  "labels": [
    "dependencies"
  ],
  "platformAutomerge": false,
  "dependencyDashboard": true,
  "commitMessagePrefix": "chore(deps): ",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 4,
  "separateMinorPatch": true,
  "enabledManagers": [
    "pep621",
    "npm",
    "dockerfile",
    "docker-compose",
    "github-actions",
    "mise",
    "pre-commit",
    "custom.regex"
  ],
  "pre-commit": {
    "enabled": true
  },
  "ignorePaths": [
    "data/**",
    "reports/**",
    "output/**",
    "dist/**"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s*\\n\\s*version:\\s*['\"]?(?<currentValue>[^'\"\\s]+)['\"]?"
      ]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 9am on monday"
    ],
    "automerge": false,
    "automergeType": "pr"
  },
  "packageRules": [
    {
      "matchManagers": [
        "pep621"
      ],
      "groupName": "python dependencies"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "web/package.json",
        "web/pnpm-lock.yaml"
      ],
      "groupName": "web dependencies"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "groupName": "docker dependencies"
    },
    {
      "description": "Node.js는 mise.toml이 단일 소스 — Dockerfile/mise 업데이트를 원자적으로 묶음",
      "matchDepNames": ["node"],
      "groupName": "node version",
      "minimumGroupSize": 3
    },
    {
      "description": "pin/digest 자동 머지 — 버전 변경 없이 고정만 강화",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["pin", "digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Python runtime pin/digest 자동 머지",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["project.dependencies", "project.optional-dependencies"],
      "matchUpdateTypes": ["pin", "digest"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "npm 런타임 patch 자동 머지",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Python dependency patch 자동 머지",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["project.dependencies", "project.optional-dependencies"],
      "matchUpdateTypes": ["patch"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchUpdateTypes": ["minor", "major"],
      "automerge": false
    },
    {
      "description": "CI/control-plane updates require manual review",
      "matchManagers": [
        "github-actions",
        "dockerfile",
        "docker-compose",
        "mise",
        "pre-commit",
        "custom.regex"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "labels": [
        "dependencies",
        "major"
      ]
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "web/package.json",
        "web/pnpm-lock.yaml"
      ],
      "matchPackageNames": [
        "eslint"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": true,
      "dependencyDashboardApproval": true
    },
    {
      "description": "mise toolchain updates require manual review",
      "matchManagers": [
        "mise"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    },
    {
      "description": "Node 런타임 버전은 Docker base image까지 함께 바뀌므로 자동 머지 금지",
      "matchDepNames": [
        "node"
      ],
      "automerge": false,
      "dependencyDashboardApproval": true
    }
  ]
}
