{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices"
  ],
  "timezone": "Asia/Seoul",
  "schedule": [
    "before 9am on monday"
  ],
  "updateNotScheduled": true,
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": true,
  "commitMessagePrefix": "chore(deps): ",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 4,
  "separateMinorPatch": true,
  "enabledManagers": [
    "pep621",
    "npm",
    "dockerfile",
    "docker-compose",
    "github-actions",
    "mise",
    "custom.regex"
  ],
  "ignorePaths": [
    "data/**",
    "reports/**",
    "output/**",
    "dist/**",
    ".pre-commit-config.yaml"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/(^|/)\\.github/workflows/.*\\.ya?ml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)(?: versioning=(?<versioning>\\S+))?\\s*\\n\\s*version:\\s*['\"]?(?<currentValue>[^'\"\\s]+)['\"]?"
      ]
    }
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "before 9am on monday"
    ],
    "automerge": false
  },
  "packageRules": [
    {
      "matchManagers": [
        "pep621"
      ],
      "groupName": "python dependencies"
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "web/package.json",
        "web/pnpm-lock.yaml"
      ],
      "groupName": "web dependencies"
    },
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "github actions"
    },
    {
      "matchManagers": [
        "dockerfile",
        "docker-compose"
      ],
      "groupName": "docker dependencies"
    },
    {
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchUpdateTypes": [
        "minor",
        "major"
      ],
      "automerge": false
    },
    {
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "labels": [
        "dependencies",
        "major"
      ]
    },
    {
      "matchManagers": [
        "npm"
      ],
      "matchFileNames": [
        "web/package.json",
        "web/pnpm-lock.yaml"
      ],
      "matchPackageNames": [
        "eslint"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": true,
      "dependencyDashboardApproval": true
    }
  ]
}
