{
  "name": "sab-web",
  "version": "1.11.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "node scripts/validate-env.mjs && node scripts/run-next.mjs dev",
    "build": "node scripts/validate-env.mjs && node scripts/run-next.mjs build",
    "start": "node scripts/validate-env.mjs && node scripts/run-next.mjs start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "next": "16.2.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "25.5.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.0",
    "@vitest/coverage-v8": "4.1.0",
    "jsdom": "28.1.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vitest": "4.1.0"
  }
}
