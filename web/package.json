{
  "name": "sab-web",
  "version": "1.31.0",
  "private": true,
  "packageManager": "pnpm@10.33.2",
  "scripts": {
    "dev": "node scripts/validate-env.mjs && node scripts/run-next.mjs dev",
    "build": "node scripts/validate-env.mjs && node scripts/run-next.mjs build",
    "start": "node scripts/validate-env.mjs && node scripts/run-next.mjs start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "next typegen && tsc --noEmit",
    "deadcode": "node scripts/check-knip-baseline.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "yaml": "2.8.3",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.5",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "jsdom": "29.0.2",
    "knip": "6.11.0",
    "prettier": "3.8.3",
    "typescript": "5.9.3",
    "vitest": "4.1.5"
  },
  "pnpm": {
    "overrides": {
      "minimatch@3>brace-expansion": "1.1.14",
      "postcss@<8.5.10": ">=8.5.10"
    }
  }
}
