{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.invalid/schemas/portfolio-outcome.o1.schema.json",
  "title": "Portfolio Outcome O1 synthetic capability contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability",
    "decisions",
    "execution_lineages",
    "user_events",
    "expected_proposals",
    "expected_public_projection"
  ],
  "properties": {
    "schema_version": { "const": "portfolio-outcome.o1" },
    "capability": { "$ref": "#/$defs/capability" },
    "decisions": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/decision" }
    },
    "execution_lineages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/executionLineage" }
    },
    "user_events": {
      "type": "array",
      "items": { "$ref": "#/$defs/userEvent" }
    },
    "expected_proposals": {
      "type": "array",
      "items": { "$ref": "#/$defs/proposal" }
    },
    "expected_public_projection": {
      "type": "array",
      "items": { "$ref": "#/$defs/publicProjection" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "decimal": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.[0-9]{6}$"
    },
    "positiveDecimal": {
      "allOf": [
        { "$ref": "#/$defs/decimal" },
        { "not": { "const": "0.000000" } }
      ]
    },
    "accountRefHash": {
      "type": "string",
      "pattern": "^hmac-sha256:v1:[0-9a-f]{64}$"
    },
    "brokerIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "status": {
      "enum": [
        "UNLINKED",
        "MATCH_PROPOSED",
        "AMBIGUOUS",
        "MATCH_CONFIRMED",
        "EXECUTED",
        "PARTIALLY_EXECUTED",
        "DISMISSED",
        "NO_ACTION",
        "UNKNOWN"
      ]
    },
    "feedbackReason": {
      "enum": [
        "EVIDENCE_DISAGREEMENT",
        "TIMING_OR_PRICE",
        "POSITION_RISK",
        "LIQUIDITY_OR_CASH",
        "EXTERNAL_CONSTRAINT",
        "CHANGED_MIND",
        "OTHER"
      ]
    },
    "userEventStatus": {
      "enum": [
        "MATCH_CONFIRMED",
        "EXECUTED",
        "PARTIALLY_EXECUTED",
        "DISMISSED",
        "UNKNOWN"
      ]
    },
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_mode",
        "provider_history_state",
        "retention_window",
        "partial_fill_mode",
        "cancel_reorder_mode",
        "automatic_match_confirmation",
        "performance_attribution"
      ],
      "properties": {
        "input_mode": { "const": "SYNTHETIC_ONLY" },
        "provider_history_state": { "const": "NOT_EVALUATED" },
        "retention_window": {
          "type": "object",
          "additionalProperties": false,
          "required": ["starts_at", "ends_at", "pagination_state"],
          "properties": {
            "starts_at": { "$ref": "#/$defs/timestamp" },
            "ends_at": { "$ref": "#/$defs/timestamp" },
            "pagination_state": { "const": "SYNTHETIC_COMPLETE" }
          }
        },
        "partial_fill_mode": { "const": "SUM_BY_EXECUTION_LINEAGE" },
        "cancel_reorder_mode": { "const": "EXPLICIT_ORDER_LINEAGE" },
        "automatic_match_confirmation": { "const": false },
        "performance_attribution": { "const": "DISABLED" }
      }
    },
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "$ref": "#/$defs/positiveDecimal" },
        "maximum": { "$ref": "#/$defs/positiveDecimal" }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decision_id",
        "instrument_id",
        "slice_id",
        "candidate_id",
        "side",
        "valid_from",
        "valid_until",
        "price_range",
        "quantity_range"
      ],
      "properties": {
        "decision_id": { "$ref": "#/$defs/uuid" },
        "instrument_id": { "$ref": "#/$defs/uuid" },
        "slice_id": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "candidate_id": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "side": { "enum": ["BUY", "SELL"] },
        "valid_from": { "$ref": "#/$defs/timestamp" },
        "valid_until": { "$ref": "#/$defs/timestamp" },
        "price_range": { "$ref": "#/$defs/range" },
        "quantity_range": { "$ref": "#/$defs/range" }
      },
      "oneOf": [
        {
          "properties": {
            "slice_id": { "$ref": "#/$defs/uuid" },
            "candidate_id": { "type": "null" },
            "side": { "const": "SELL" }
          }
        },
        {
          "properties": {
            "slice_id": { "type": "null" },
            "candidate_id": { "$ref": "#/$defs/uuid" },
            "side": { "const": "BUY" }
          }
        }
      ]
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broker_order_id",
        "supersedes_broker_order_id",
        "state",
        "created_at"
      ],
      "properties": {
        "broker_order_id": { "$ref": "#/$defs/brokerIdentifier" },
        "supersedes_broker_order_id": {
          "oneOf": [
            { "$ref": "#/$defs/brokerIdentifier" },
            { "type": "null" }
          ]
        },
        "state": { "enum": ["CANCELED", "PARTIALLY_FILLED", "FILLED"] },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "fill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broker_order_id",
        "broker_fill_id",
        "executed_at",
        "price",
        "quantity"
      ],
      "properties": {
        "broker_order_id": { "$ref": "#/$defs/brokerIdentifier" },
        "broker_fill_id": { "$ref": "#/$defs/brokerIdentifier" },
        "executed_at": { "$ref": "#/$defs/timestamp" },
        "price": { "$ref": "#/$defs/positiveDecimal" },
        "quantity": { "$ref": "#/$defs/positiveDecimal" }
      }
    },
    "executionLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_lineage_id",
        "outcome_lineage_id",
        "account_ref_hash",
        "instrument_id",
        "side",
        "slice_candidate_ids",
        "candidate_id",
        "orders",
        "fills"
      ],
      "properties": {
        "execution_lineage_id": { "$ref": "#/$defs/uuid" },
        "outcome_lineage_id": { "$ref": "#/$defs/uuid" },
        "account_ref_hash": { "$ref": "#/$defs/accountRefHash" },
        "instrument_id": { "$ref": "#/$defs/uuid" },
        "side": { "enum": ["BUY", "SELL"] },
        "slice_candidate_ids": {
          "type": "array",
          "minItems": 0,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        },
        "candidate_id": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "orders": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/order" }
        },
        "fills": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fill" }
        }
      },
      "oneOf": [
        {
          "properties": {
            "slice_candidate_ids": { "type": "array", "minItems": 1 },
            "candidate_id": { "type": "null" },
            "side": { "const": "SELL" }
          }
        },
        {
          "properties": {
            "slice_candidate_ids": { "type": "array", "maxItems": 0 },
            "candidate_id": { "$ref": "#/$defs/uuid" },
            "side": { "const": "BUY" }
          }
        }
      ]
    },
    "proposal": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_lineage_id",
        "execution_lineage_id",
        "status",
        "candidate_decision_ids",
        "total_filled_quantity"
      ],
      "properties": {
        "outcome_lineage_id": { "$ref": "#/$defs/uuid" },
        "execution_lineage_id": { "$ref": "#/$defs/uuid" },
        "status": {
          "enum": ["UNLINKED", "MATCH_PROPOSED", "AMBIGUOUS"]
        },
        "candidate_decision_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        },
        "total_filled_quantity": { "$ref": "#/$defs/positiveDecimal" }
      }
    },
    "userEvent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_event_id",
        "outcome_lineage_id",
        "event_kind",
        "actor_kind",
        "status",
        "decision_id",
        "confirmed_quantity",
        "feedback_reason",
        "feedback_note_private",
        "supersedes_event_id",
        "created_at"
      ],
      "properties": {
        "outcome_event_id": { "$ref": "#/$defs/uuid" },
        "outcome_lineage_id": { "$ref": "#/$defs/uuid" },
        "event_kind": {
          "enum": ["MATCH_CONFIRMATION", "CORRECTION", "FEEDBACK"]
        },
        "actor_kind": { "const": "USER" },
        "status": { "$ref": "#/$defs/userEventStatus" },
        "decision_id": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "confirmed_quantity": {
          "oneOf": [
            { "$ref": "#/$defs/positiveDecimal" },
            { "type": "null" }
          ]
        },
        "feedback_reason": {
          "oneOf": [
            { "$ref": "#/$defs/feedbackReason" },
            { "type": "null" }
          ]
        },
        "feedback_note_private": {
          "oneOf": [
            { "type": "string", "minLength": 1, "maxLength": 1000 },
            { "type": "null" }
          ]
        },
        "supersedes_event_id": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "created_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "MATCH_CONFIRMED",
                  "EXECUTED",
                  "PARTIALLY_EXECUTED"
                ]
              }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "decision_id": { "$ref": "#/$defs/uuid" },
              "confirmed_quantity": { "$ref": "#/$defs/positiveDecimal" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": { "enum": ["DISMISSED", "UNKNOWN"] }
            },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "decision_id": { "type": "null" },
              "confirmed_quantity": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": { "feedback_reason": { "const": "OTHER" } },
            "required": ["feedback_reason"]
          },
          "then": {
            "properties": {
              "feedback_note_private": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              }
            }
          }
        },
        {
          "if": {
            "properties": { "feedback_reason": { "type": "null" } },
            "required": ["feedback_reason"]
          },
          "then": {
            "properties": {
              "feedback_note_private": { "type": "null" }
            }
          }
        }
      ]
    },
    "publicProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_lineage_id",
        "status",
        "decision_id",
        "feedback_reason",
        "last_event_id",
        "last_event_at"
      ],
      "properties": {
        "outcome_lineage_id": { "$ref": "#/$defs/uuid" },
        "status": { "$ref": "#/$defs/userEventStatus" },
        "decision_id": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "feedback_reason": {
          "oneOf": [
            { "$ref": "#/$defs/feedbackReason" },
            { "type": "null" }
          ]
        },
        "last_event_id": { "$ref": "#/$defs/uuid" },
        "last_event_at": { "$ref": "#/$defs/timestamp" }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": { "enum": ["DISMISSED", "UNKNOWN"] }
            },
            "required": ["status"]
          },
          "then": {
            "properties": { "decision_id": { "type": "null" } }
          },
          "else": {
            "properties": {
              "decision_id": { "$ref": "#/$defs/uuid" }
            }
          }
        }
      ]
    }
  }
}
