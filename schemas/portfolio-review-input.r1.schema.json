{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "portfolio-review-input.r1"
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "mandate_version_id": {
            "type": "string",
            "format": "uuid"
          },
          "instrument_id": {
            "type": "string",
            "format": "uuid"
          },
          "approval_state": {
            "enum": [
              "APPROVED",
              "DRAFT",
              "NEEDS_REAPPROVAL"
            ]
          },
          "classification_state": {
            "enum": [
              "ACTIVE",
              "UNCLASSIFIED",
              "EXIT_REVIEW",
              "CLOSED"
            ]
          },
          "horizon": {
            "anyOf": [
              {
                "enum": [
                  "SWING",
                  "LONG_TERM"
                ]
              },
              {
                "type": "null"
              }
            ]
          },
          "approved_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "effective_from": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "effective_to": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "holding_document": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 131072
              },
              {
                "type": "null"
              }
            ]
          },
          "holding_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "source_document_sha256": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^sha256:[0-9a-f]{64}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "policy_recorded_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "broker": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "snapshot_version": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "captured_at": {
                    "type": "string",
                    "format": "date-time"
                  },
                  "sealed_input_hash": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  },
                  "allocation_snapshot_version": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "allocation_version": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 1
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "slices": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "slice_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "eligible": {
                          "type": "boolean"
                        },
                        "classification_state": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 30
                        }
                      },
                      "required": [
                        "slice_id",
                        "eligible",
                        "classification_state"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 100
                  }
                },
                "required": [
                  "snapshot_version",
                  "captured_at",
                  "sealed_input_hash",
                  "allocation_snapshot_version",
                  "allocation_version",
                  "slices"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "observations": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "observation_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "rule_path": {
                  "type": "string",
                  "pattern": "^(hard_triggers|signals)/[0-9]{1,2}/[0-9]{1,2}$"
                },
                "period_key": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 10
                },
                "metric": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "unit": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "observed_value": {
                  "type": [
                    "string",
                    "boolean"
                  ]
                },
                "evidence_seal_id": {
                  "type": "string",
                  "format": "uuid"
                },
                "source_content_sha256": {
                  "type": "string",
                  "pattern": "^sha256:[0-9a-f]{64}$"
                },
                "source_tier": {
                  "const": "PRIMARY"
                },
                "authority": {
                  "enum": [
                    "USER",
                    "DETERMINISTIC_PARSER"
                  ]
                },
                "parser_version": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "recorded_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "supersedes_observation_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "uuid"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "source_event_time": {
                  "type": "string",
                  "format": "date-time"
                },
                "sealed_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "source_instrument_id": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "observation_id",
                "rule_path",
                "period_key",
                "metric",
                "unit",
                "observed_value",
                "evidence_seal_id",
                "source_content_sha256",
                "source_tier",
                "authority",
                "parser_version",
                "recorded_at",
                "supersedes_observation_id",
                "source_event_time",
                "sealed_at",
                "source_instrument_id"
              ],
              "additionalProperties": false
            },
            "maxItems": 1000
          }
        },
        "required": [
          "mandate_version_id",
          "instrument_id",
          "approval_state",
          "classification_state",
          "horizon",
          "approved_at",
          "effective_from",
          "effective_to",
          "holding_document",
          "holding_sha256",
          "source_document_sha256",
          "policy_recorded_at",
          "broker",
          "observations"
        ],
        "additionalProperties": false
      },
      "maxItems": 100,
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "read_at",
    "rows"
  ],
  "additionalProperties": false,
  "$defs": {
    "holding": {
      "type": "object",
      "properties": {
        "approval_state": {
          "const": "APPROVED"
        },
        "classification_state": {
          "const": "ACTIVE"
        },
        "horizon": {
          "const": "LONG_TERM"
        },
        "invalidation_policy": {
          "type": "object",
          "properties": {
            "outcome": {
              "const": "THESIS_INVALIDATED_REVIEW_REQUIRED"
            },
            "hard_triggers": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 2000
                  },
                  "condition_match": {
                    "enum": [
                      "ALL",
                      "ANY"
                    ]
                  },
                  "conditions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "metric": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 200
                        },
                        "operator": {
                          "enum": [
                            "<",
                            "<=",
                            ">",
                            ">=",
                            "==",
                            "EVENT_OCCURRED",
                            "RATING_BELOW"
                          ]
                        },
                        "threshold": {
                          "type": [
                            "number",
                            "string",
                            "boolean"
                          ]
                        },
                        "unit": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 100
                        },
                        "period": {
                          "enum": [
                            "EVENT",
                            "QUARTER",
                            "YEAR",
                            "TRAILING_YEAR"
                          ]
                        }
                      },
                      "required": [
                        "metric",
                        "operator",
                        "threshold",
                        "unit",
                        "period"
                      ],
                      "additionalProperties": false
                    },
                    "maxItems": 20,
                    "minItems": 1
                  }
                },
                "required": [
                  "id",
                  "description"
                ],
                "additionalProperties": false
              },
              "maxItems": 20,
              "minItems": 1
            },
            "deterioration_rule": {
              "type": "object",
              "properties": {
                "minimum_matches": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 20
                },
                "consecutive_periods": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 8
                },
                "period": {
                  "const": "QUARTER"
                },
                "signals": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      },
                      "description": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 2000
                      },
                      "condition_match": {
                        "enum": [
                          "ALL",
                          "ANY"
                        ]
                      },
                      "conditions": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "metric": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 200
                            },
                            "operator": {
                              "enum": [
                                "<",
                                "<=",
                                ">",
                                ">=",
                                "==",
                                "EVENT_OCCURRED",
                                "RATING_BELOW"
                              ]
                            },
                            "threshold": {
                              "type": [
                                "number",
                                "string",
                                "boolean"
                              ]
                            },
                            "unit": {
                              "type": "string",
                              "minLength": 1,
                              "maxLength": 100
                            },
                            "period": {
                              "enum": [
                                "EVENT",
                                "QUARTER",
                                "YEAR",
                                "TRAILING_YEAR"
                              ]
                            }
                          },
                          "required": [
                            "metric",
                            "operator",
                            "threshold",
                            "unit",
                            "period"
                          ],
                          "additionalProperties": false
                        },
                        "maxItems": 20,
                        "minItems": 1
                      }
                    },
                    "required": [
                      "id",
                      "description"
                    ],
                    "additionalProperties": false
                  },
                  "maxItems": 20,
                  "minItems": 1
                }
              },
              "required": [
                "minimum_matches",
                "consecutive_periods",
                "period",
                "signals"
              ],
              "additionalProperties": false
            },
            "special_review_rules": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "maxItems": 20
            }
          },
          "required": [
            "outcome",
            "hard_triggers",
            "deterioration_rule",
            "special_review_rules"
          ],
          "additionalProperties": false
        },
        "review_cadence": {
          "type": "object",
          "properties": {
            "quarterly": {
              "const": "NEXT_OFFICIAL_FILING"
            },
            "annual_review_by": {
              "type": "string",
              "format": "date"
            },
            "event_driven": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "maxItems": 20
            }
          },
          "required": [
            "quarterly",
            "annual_review_by",
            "event_driven"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "approval_state",
        "classification_state",
        "horizon",
        "invalidation_policy",
        "review_cadence"
      ],
      "additionalProperties": true
    }
  }
}
