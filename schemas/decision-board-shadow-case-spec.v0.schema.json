{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swing-trading-report.local/schemas/decision-board-shadow-case-spec.v0.schema.json",
  "title": "Decision Board Shadow Case Specification V0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_version", "snapshots"],
  "properties": {
    "schema_version": { "const": "decision-board-shadow-case-spec.v0" },
    "gate_version": { "$ref": "#/$defs/Identifier" },
    "snapshots": {
      "type": "array",
      "minItems": 2,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/EntrySnapshotSpec" },
          { "$ref": "#/$defs/HoldingSnapshotSpec" }
        ]
      },
      "allOf": [
        {
          "contains": { "$ref": "#/$defs/EntrySnapshotSpec" },
          "minContains": 1
        },
        {
          "contains": { "$ref": "#/$defs/HoldingSnapshotSpec" },
          "minContains": 1
        }
      ]
    }
  },
  "$defs": {
    "Identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "ItemIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "MetadataVersion": {
      "type": "string",
      "pattern": "^(?!(?:.*[._-])?(?:[Aa][Cc][Cc][Oo][Uu][Nn][Tt]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Aa][Ss][Ss][Ww][Oo][Rr][Dd]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Tt][Oo][Kk][Ee][Nn])(?:[._-]|$))[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "PublicText": { "type": "string", "minLength": 1 },
    "Metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "eligible_count": { "type": "integer", "minimum": 0 },
        "selected_count": { "type": "integer", "minimum": 0 },
        "policy_version": { "$ref": "#/$defs/MetadataVersion" },
        "registry_version": { "$ref": "#/$defs/MetadataVersion" },
        "researcher_version": { "$ref": "#/$defs/MetadataVersion" },
        "verifier_version": { "$ref": "#/$defs/MetadataVersion" },
        "provider_finnhub_attempts": { "type": "integer", "minimum": 0 },
        "provider_finnhub_failures": { "type": "integer", "minimum": 0 },
        "provider_finnhub_timeouts": { "type": "integer", "minimum": 0 },
        "provider_polygon_news_attempts": { "type": "integer", "minimum": 0 },
        "provider_polygon_news_failures": { "type": "integer", "minimum": 0 },
        "provider_polygon_news_timeouts": { "type": "integer", "minimum": 0 },
        "provider_benzinga_news_attempts": { "type": "integer", "minimum": 0 },
        "provider_benzinga_news_failures": { "type": "integer", "minimum": 0 },
        "provider_benzinga_news_timeouts": { "type": "integer", "minimum": 0 }
      }
    },
    "Instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "market",
        "canonical_ticker",
        "exchange",
        "company_name",
        "identity_source",
        "identity_version"
      ],
      "properties": {
        "market": { "const": "US" },
        "canonical_ticker": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9]*(?:[./-][A-Z0-9]+)*$"
        },
        "exchange": { "enum": ["NASDAQ", "NYSE", "AMEX"] },
        "company_name": { "$ref": "#/$defs/PublicText" },
        "identity_source": { "$ref": "#/$defs/PublicText" },
        "identity_version": { "$ref": "#/$defs/PublicText" }
      }
    },
    "ApprovalState": { "enum": ["APPROVED", "REVIEW"] },
    "DependencyState": {
      "enum": ["CURRENT", "MISSING", "STALE", "AMBIGUOUS", "CONFLICTED"]
    },
    "EntrySignalState": {
      "enum": [
        "READY_ENTER",
        "ABSENT",
        "NOT_READY_ENTER",
        "MISSING",
        "STALE",
        "AMBIGUOUS",
        "CONFLICTED"
      ]
    },
    "ExposureState": {
      "enum": ["PASS", "FAIL", "MISSING", "STALE", "AMBIGUOUS", "CONFLICTED"]
    },
    "EntryItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "instrument",
        "item_state",
        "identity_state",
        "signal_state",
        "mandate_state",
        "price_state",
        "exposure_state"
      ],
      "properties": {
        "item_id": { "type": "string", "pattern": "^entry-[A-Za-z0-9._:-]{1,122}$" },
        "instrument": { "$ref": "#/$defs/Instrument" },
        "item_state": { "$ref": "#/$defs/ApprovalState" },
        "identity_state": { "$ref": "#/$defs/ApprovalState" },
        "signal_state": { "$ref": "#/$defs/EntrySignalState" },
        "mandate_state": { "$ref": "#/$defs/DependencyState" },
        "price_state": { "$ref": "#/$defs/DependencyState" },
        "exposure_state": { "$ref": "#/$defs/ExposureState" }
      }
    },
    "HoldingItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_id",
        "instrument",
        "item_state",
        "identity_state",
        "hard_exit_state",
        "broker_state",
        "candle_state",
        "rule_state",
        "research_priority",
        "research_order"
      ],
      "properties": {
        "item_id": { "type": "string", "pattern": "^holding-[A-Za-z0-9._:-]{1,120}$" },
        "instrument": { "$ref": "#/$defs/Instrument" },
        "item_state": { "$ref": "#/$defs/ApprovalState" },
        "identity_state": { "$ref": "#/$defs/ApprovalState" },
        "hard_exit_state": { "enum": ["NONE", "HARD_STOP", "CONFIRMED_EXIT"] },
        "broker_state": { "$ref": "#/$defs/DependencyState" },
        "candle_state": { "$ref": "#/$defs/DependencyState" },
        "rule_state": { "$ref": "#/$defs/DependencyState" },
        "research_priority": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "research_order": { "$ref": "#/$defs/ItemIdentifier" }
      }
    },
    "EntryCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "item_id", "expected_action_set"],
      "properties": {
        "case_id": { "$ref": "#/$defs/Identifier" },
        "item_id": { "type": "string", "pattern": "^entry-[A-Za-z0-9._:-]{1,122}$" },
        "expected_action_set": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["BUY", "AVOID", "REVIEW", "OMITTED"] }
        }
      }
    },
    "HoldingCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["case_id", "item_id", "expected_action_set"],
      "properties": {
        "case_id": { "$ref": "#/$defs/Identifier" },
        "item_id": { "type": "string", "pattern": "^holding-[A-Za-z0-9._:-]{1,120}$" },
        "expected_action_set": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["HOLD", "SELL", "REVIEW", "OMITTED"] }
        }
      }
    },
    "EntrySnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "run_kind", "metadata", "items"],
      "properties": {
        "schema": { "const": "sab.decision_board.sealed_request.v0" },
        "run_kind": { "const": "ENTRY" },
        "metadata": { "$ref": "#/$defs/Metadata" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/EntryItem" } }
      }
    },
    "HoldingSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "run_kind", "metadata", "items"],
      "properties": {
        "schema": { "const": "sab.decision_board.sealed_request.v0" },
        "run_kind": { "const": "HOLDING" },
        "metadata": { "$ref": "#/$defs/Metadata" },
        "items": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/HoldingItem" } }
      }
    },
    "EntrySnapshotSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "cases"],
      "properties": {
        "snapshot": { "$ref": "#/$defs/EntrySnapshot" },
        "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/EntryCase" } }
      }
    },
    "HoldingSnapshotSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "cases"],
      "properties": {
        "snapshot": { "$ref": "#/$defs/HoldingSnapshot" },
        "cases": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/HoldingCase" } }
      }
    }
  }
}
