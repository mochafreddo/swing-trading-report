{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.swing-trading-report.invalid/schemas/portfolio-outcome-history-t15.schema.json",
  "title": "Portfolio Outcome T15 provider-free history pages",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "input_mode",
    "provider_history_state",
    "pages"
  ],
  "properties": {
    "schema_version": { "const": "portfolio-outcome-history.t15" },
    "input_mode": { "enum": ["RECORDED", "REDACTED_IMPORT"] },
    "provider_history_state": { "const": "NOT_EVALUATED" },
    "pages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/$defs/page" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "format": "uuid",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}\\.[0-9]{3}Z$"
    },
    "positiveDecimal": {
      "type": "string",
      "pattern": "^(?!0\\.000000$)(0|[1-9][0-9]*)\\.[0-9]{6}$"
    },
    "accountRefHash": {
      "type": "string",
      "pattern": "^hmac-sha256:v1:[0-9a-f]{64}$"
    },
    "brokerIdentifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "order": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broker_order_id",
        "supersedes_broker_order_id",
        "state",
        "created_at"
      ],
      "properties": {
        "broker_order_id": { "$ref": "#/$defs/brokerIdentifier" },
        "supersedes_broker_order_id": {
          "oneOf": [
            { "$ref": "#/$defs/brokerIdentifier" },
            { "type": "null" }
          ]
        },
        "state": { "enum": ["CANCELED", "PARTIALLY_FILLED", "FILLED"] },
        "created_at": { "$ref": "#/$defs/timestamp" }
      }
    },
    "fill": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "broker_order_id",
        "broker_fill_id",
        "executed_at",
        "price",
        "quantity"
      ],
      "properties": {
        "broker_order_id": { "$ref": "#/$defs/brokerIdentifier" },
        "broker_fill_id": { "$ref": "#/$defs/brokerIdentifier" },
        "executed_at": { "$ref": "#/$defs/timestamp" },
        "price": { "$ref": "#/$defs/positiveDecimal" },
        "quantity": { "$ref": "#/$defs/positiveDecimal" }
      }
    },
    "executionLineage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "execution_lineage_id",
        "outcome_lineage_id",
        "account_ref_hash",
        "instrument_id",
        "side",
        "slice_candidate_ids",
        "candidate_id",
        "orders",
        "fills"
      ],
      "properties": {
        "execution_lineage_id": { "$ref": "#/$defs/uuid" },
        "outcome_lineage_id": { "$ref": "#/$defs/uuid" },
        "account_ref_hash": { "$ref": "#/$defs/accountRefHash" },
        "instrument_id": { "$ref": "#/$defs/uuid" },
        "side": { "enum": ["BUY", "SELL"] },
        "slice_candidate_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/uuid" }
        },
        "candidate_id": {
          "oneOf": [{ "$ref": "#/$defs/uuid" }, { "type": "null" }]
        },
        "orders": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/order" }
        },
        "fills": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/fill" }
        }
      },
      "oneOf": [
        {
          "properties": {
            "slice_candidate_ids": { "minItems": 1 },
            "candidate_id": { "type": "null" },
            "side": { "const": "SELL" }
          }
        },
        {
          "properties": {
            "slice_candidate_ids": { "maxItems": 0 },
            "candidate_id": { "$ref": "#/$defs/uuid" },
            "side": { "const": "BUY" }
          }
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["request_cursor", "next_cursor", "execution_lineages"],
      "properties": {
        "request_cursor": {
          "oneOf": [
            { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
            { "type": "null" }
          ]
        },
        "next_cursor": {
          "oneOf": [
            { "type": "string", "pattern": "^[A-Za-z0-9._:-]{1,128}$" },
            { "type": "null" }
          ]
        },
        "execution_lineages": {
          "type": "array",
          "items": { "$ref": "#/$defs/executionLineage" }
        }
      }
    }
  }
}
