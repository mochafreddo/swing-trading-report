{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://swing-trading-report.local/schemas/decision-board-shadow-expected-action-ledger.v0.schema.json",
  "title": "Decision Board Shadow Expected Action Ledger V0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "gate_version", "cases"],
  "properties": {
    "schema_version": {
      "const": "decision-board-shadow-expected-action-ledger.v0"
    },
    "gate_version": { "$ref": "#/$defs/id" },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["case_id", "expected_action_set"],
        "properties": {
          "case_id": { "$ref": "#/$defs/id" },
          "expected_action_set": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": ["BUY", "AVOID", "HOLD", "SELL", "REVIEW", "OMITTED"]
            }
          }
        }
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    }
  }
}
